# Local development only; leave blank to use SQLite in data/roster.db.
# Production must set DATABASE_URL to a PostgreSQL connection URL.
DATABASE_URL=
# Example Supabase URL; replace the placeholder with a URL-encoded password:
# postgresql+psycopg://postgres:YOUR_URL_ENCODED_PASSWORD@db.cjlzgofgrcbdjpzlrcjl.supabase.co:5432/postgres?sslmode=require
APP_ENV=development
# Optional n8n webhook URL for roster events
N8N_WEBHOOK_URL=
API_URL=http://localhost:8000
# Set to your deployed Streamlit Community Cloud origin for production.
FRONTEND_URL=http://localhost:8501
# Optional comma-separated additional CORS origins.
CORS_ORIGINS=
